# 构建产物
build/
.vs/
vsxmake*/
compile_commands.json
.xmake/

# 编译中间物
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.dll
*.exe

# Python（tools/re 下的引擎逆向脚本）
__pycache__/
*.pyc

# 兼容性核查用的临时工作目录（解压、xDump 日志等中间物）
tools/re/_sil_tmp/

# 第三方源码树 / 工具下载目录（体积大，不入库）
tools/commonlibsf-main/
tools/vendor/
tools/xedit-scripts/_archive/
tools/*.sf1viewsettings

# xEdit 源码（体积大）
TES5Edit-xedit-4.1.5f/
TES5Edit-xedit-4.1.5f-source-code.zip

# 本地回退备份（旧版本的 ESM / pex / dll，不入库）
out/backup-*/
out/tmp/

# out/ 下其余都是「逆向/调试中间产物」（反汇编 dump、字符串 dump …），
# 随时可以用 tools/re 里的脚本重跑，不入库
out/

# Nexus 发布包（可由 tools/package-nexus.ps1 随时重新生成）
dist/

# 编辑器/系统
.vscode/
.idea/
Thumbs.db
desktop.ini
*~

# 用户贴进工作区的截图（不属于项目源码）
image.png

# 日志
*.log

# ---------------------------------------------------------------------------
# 汉化工作区（tr/）
# tr/lang 里的词典/词元表/批次是"手工成果"，必须入库；
# 其余都是可再生的中间物或体积巨大的二进制，不入库：
#   tr/data   —— 指向游戏 Starfield.esm 的硬链接 + 5 个原始 mod 的副本
#   tr/orig   —— 原始 mod 备份
#   tr/loc    —— 从游戏 Localization.ba2 解出的官方 .strings（约 22 MB）
#   tr/build  —— 生成好的汉化 ESM（约 90 MB，真正交付物在 MO2 里）
#   tr/out    —— 从 ESM 抽出的字符串表与映射表（可由 trtool.py extract 再生）
# ---------------------------------------------------------------------------
tr/data/
tr/orig/
tr/loc/
tr/build/
tr/out/
tr/*.sf1viewsettings

# dict_full.tsv = merge(dict.tsv, official_seed.tsv, tr/loc/starfield_en_zh.tsv)
# 含 15 万条官方对照，约 22 MB，一条命令即可再生 ⇒ 不入库
tr/lang/dict_full.tsv

# 文档/配置的一次性备份（合并 INI、精简文档时的 .bak-*）
*.bak-*
*.bak
